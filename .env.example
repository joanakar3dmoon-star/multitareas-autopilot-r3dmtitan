# Never commit real secrets.
MULTITAREAS_API_TOKEN=
HOST=0.0.0.0
PORT=8000
MULTITAREAS_DATABASE=data/multitareas.db
AI_PROVIDER=ollama
AI_REMOTE_ENABLED=0
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=
XAI_API_KEY=
POLLINATIONS_MODEL=
POLLINATIONS_BASE_URL=
POLLINATIONS_API_KEY=
# Cerebro event bridge: no delivery until the real receiver path and secret are configured.
CEREBRO_BASE_URL=
CEREBRO_SHARED_SECRET=
CEREBRO_HEALTH_PATH=/health
CEREBRO_EVENTS_PATH=
# Multifunction job handoff: requires the target API from its PR to be merged and deployed.
MULTIFUNCION_BRIDGE_ENABLED=0
MULTIFUNCION_BASE_URL=
MULTIFUNCION_API_TOKEN=
MULTIFUNCION_HEALTH_PATH=/api/pulpos/health
MULTIFUNCION_JOBS_PATH=/api/pulpos/jobs
# Platform adapters: configure only after reviewing official API terms.
DEALWORK_ENABLED=0
MARKETPLACE_ADAPTERS_ENABLED=0
AFFILIATE_ADAPTERS_ENABLED=0
PAYMENT_WEBHOOK_SECRET=
BANKING_PROVIDER=
BANKING_OAUTH_CLIENT_ID=
BANKING_OAUTH_CLIENT_SECRET=
BROKER_ADAPTER=
GAMMA_MODE=RESEARCH_ONLY
ALLOW_OUTBOUND_TRANSFERS=0
ALLOW_AGENT_SPEND=0
ALLOW_AUTOMATED_INVESTMENT_ORDERS=0
